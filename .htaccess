Options -Indexes -MultiViews
<FilesMatch "^(config(?:\.example)?\.php|composer\.(json|lock)|router\.php|security_test_results\.json|.*\.(sql|md|pem|log|txt))$">
 Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:storage|includes|tools|tests|database|migrations|docs|vendor|\.git)(?:/|$) - [F,L]
